# ============================================
# NegocioSmart — Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================

# ---- Base de Datos ----
DATABASE_URL="postgresql://negociosmart:negociosmart_dev@localhost:5432/negociosmart"
REDIS_URL="redis://localhost:6379"

# ---- JWT ----
# Genera con: openssl rand -base64 64
JWT_SECRET="cambia-esto-por-un-secreto-seguro-generado-aleatoriamente"
JWT_EXPIRES_IN="7d"

# ---- OpenAI ----
OPENAI_API_KEY="sk-proj-..."

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# IDs de precios en Stripe Dashboard
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ---- Servidor ----
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---- Email (SendGrid) ----
SENDGRID_API_KEY="SG...."
EMAIL_FROM="hola@negociosmart.com"
EMAIL_FROM_NAME="NegocioSmart"

# ---- WhatsApp (Meta Cloud API) ----
WHATSAPP_ACCESS_TOKEN="..."
WHATSAPP_PHONE_NUMBER_ID="..."
WHATSAPP_VERIFY_TOKEN="..."

# ---- AWS (producción) ----
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="negociosmart-uploads"
